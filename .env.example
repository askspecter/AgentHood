# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
#
# On Vercel, set these under Settings → Environment Variables instead.

# ─── Session signing (required) ─────────────────────────────────────────────
# Signs the login cookie. Without it the app returns a setup error instead of
# signing anyone in. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── X (Twitter) sign-in ────────────────────────────────────────────────────
# Create an app at https://developer.x.com → your project → Keys and tokens.
# In "User authentication settings": enable OAuth 2.0, App type = Web App
# (confidential client), and register the callback URL verbatim:
#   Local:      http://localhost:3000/api/auth/x/callback
#   Production: https://<your-domain>/api/auth/x/callback
#
# Both of these are required. Without them the sign-in button returns you to the
# app with a panel naming what is missing, rather than an error page.
X_CLIENT_ID=
X_CLIENT_SECRET=

# OPTIONAL. The callback URL is derived from the incoming request, so it is
# already correct on Vercel and on localhost. Set this only if the app is served
# on a public URL the request headers do not report — and then it must match what
# X has registered EXACTLY, including scheme and path.
# X_REDIRECT_URI=https://<your-domain>/api/auth/x/callback

# OPTIONAL. Overrides the origin used to build the callback and to redirect back
# to after sign-in. Same reasoning as above; leave unset unless you need it.
# APP_ORIGIN=https://<your-domain>

# ─── Wallets derived from X accounts ────────────────────────────────────────
# Signing in with X mints a wallet from HMAC(this secret, x user id). Required
# for the Wallet tab and for the terminal to trade without a browser extension.
# ⚠️  Set it ONCE. Changing it orphans every wallet derived from the old value.
WALLET_DERIVATION_SECRET=

# ─── Pricing ────────────────────────────────────────────────────────────────
# Prices and market caps are shown in USD, converted from the pool's WETH price
# using a rate fetched from Coinbase (CoinGecko as a fallback), cached 60s. If no
# source can be reached the UI falls back to WETH rather than inventing a figure.
# Set this to pin the rate for offline development or tests.
# ETH_USD_PRICE=

# ─── Robinhood Chain RPC ────────────────────────────────────────────────────
# The public endpoint works, but the pons docs warn it times out on wide
# eth_getLogs ranges. A private RPC is faster and won't rate-limit you.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_EXPLORER=https://robinhoodchain.blockscout.com

# How many recent blocks to replay for holder concentration. Higher = more
# accurate, slower. Lower this if audits time out on a serverless host.
AUDIT_MAX_BLOCKS=30000

# ─── Hiding tokens (test launches, spam) ────────────────────────────────────
# A token on the chain cannot be deleted, so "removing" one means hiding it from
# every list this site renders: the launch feed, the launched-here list, and
# portfolio scans. Comma-separated addresses. Pasting the address directly still
# resolves it on purpose — hiding must never break the audit page.
# HIDDEN_TOKENS=0x...,0x...

# ─── The official token ($ESKA), pinned as the hero card ─────────────────────
# The pinned token leads the feed (the big hero card), marked OFFICIAL, and gets
# the GOLD verified check in the UI. It lives on pons, not in this site's
# registry, so this is how it shows there at all. Defaults to the $ESKA address
# in lib/engine/registry.js; override any field to pin a different token, or set
# OFFICIAL_TOKEN to empty to drop the pin entirely.
# OFFICIAL_TOKEN=0x0eB9960654d3661D551a4536D7d425184eC81756
# OFFICIAL_X=eskafun
# OFFICIAL_SYMBOL=ESKA
# OFFICIAL_NAME=ESKA

# ─── MCP server (AI access) ──────────────────────────────────────────────────
# ESKA exposes a Model Context Protocol server at /api/mcp so an AI client
# (Claude, Cursor, …) can browse coins, quote, trade and launch. Users mint a
# personal API key at Settings → AI access (POST /api/keys); it is a signed,
# stateless token carrying their X user id — spend authority over their custodial
# wallet — so it's treated like a password.
#
# Read tools (list/get/quote/burned/leaderboard) are always open. The spending
# tools (wallet/trade/launch_coin) require a valid key AND this master switch,
# which is OFF by default. Turn it on only after testing with tiny amounts.
# ESKA_MCP_WRITE=on
# Optional dedicated signing secret for API keys (defaults to SESSION_SECRET).
# MCP_KEY_SECRET=change-me-to-a-long-random-string

# ─── Discover feed scope ─────────────────────────────────────────────────────
# By default the Discover feed shows ONLY coins launched through eska.fun (this
# site's registry) plus the official $ESKA pin — not the wider pons universe.
# Set ESKA_FEED_PONS=on to also surface curated + auto-discovered pons coins.
# ESKA_FEED_PONS=on

# ─── pons contract overrides (optional) ─────────────────────────────────────
# Defaults in lib/engine/chains.js come from the official pons docs. Override
# here if pons ships a new factory, or to pin your own verified addresses.
PONS_FACTORY=
PONS_ROUTER=
PONS_QUOTER=
ROBINHOOD_WETH=

# USDG (Global Dollar) — the stablecoin Robinhood Chain's tokenized stocks are
# paired against. Launches trade against WETH; stocks trade against this, because
# that is the pool they actually have. Defaults to the known mainnet address in
# lib/engine/chains.js; override to pin your own verified address.
PONS_USDG=

# ─── Contract deployment (only for deploying your own token) ────────────────
# ⚠️  Controls real money. Use a FRESH wallet holding only the gas you need.
#     Never paste this into a chat, a website, or a "support" DM.
#     Not needed to run the website.
PRIVATE_KEY=
TREASURY_ADDRESS=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=

# ─── AI: Idea/more buttons + logo generation (optional) ─────────────────────
# Text suggestions (name/look/personality/tagline "Idea" and "more" buttons) use
# OpenAI gpt-4o-mini. Create a key at https://platform.openai.com/api-keys.
# If unset, those buttons fall back to built-in suggestions.
OPENAI_API_KEY=

# OPTIONAL — use any OpenAI-compatible gateway instead of OpenAI directly, e.g.
# the Bankr LLM Gateway. Set these to switch without code changes:
#   AI_TEXT_BASE_URL=https://llm.bankr.bot/v1
#   AI_TEXT_API_KEY=bk_YOUR_KEY          # Bankr keys auto-use the X-API-Key header
#   AI_TEXT_MODEL=gpt-4o-mini            # or any model the gateway supports
# AI_TEXT_AUTH=x-api-key|bearer          # only if auto-detection needs overriding
# AI_TEXT_BASE_URL=
# AI_TEXT_API_KEY=
# AI_TEXT_MODEL=

# Coin logo generation on the Launch "Generate" step uses FLUX.1 [schnell] on
# fal.ai. Create a key at https://fal.ai/dashboard/keys. If unset, the flow uses
# the procedural avatar instead (uploading an image still works).
FAL_KEY=

# ─── Storage: durable logos + launch registry (Vercel KV / Upstash Redis) ────
# Coin logos (AI-generated or uploaded) are stored here so the on-chain logo URL
# never breaks. Also backs the launch registry. Create a KV/Redis store in Vercel
# Storage and connect it to the project — these are set automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Absolute origin used to build logo URLs stored on-chain (e.g. https://eska.fun).
# Optional — derived from the request when unset.
# PUBLIC_ORIGIN=https://eska.fun

# ─── Creator fees / ESKA revenue split (optional) ───────────────────────────
# pons pays 30% of pool fees to the protocol and the rest to the creator-fee
# recipient set at launch. By default ESKA sets that recipient to the creator's
# own wallet (pons-native 70/30) and the Claim button pays them directly.
#
# Set ESKA_FEE_SPLIT=on to take ESKA's cut of the creator share instead:
# 60% creator / 30% pons / 10% ESKA. On claim, the fees still land in the
# creator's own wallet first, then 10/70 is skimmed off: 5% to the buyback
# collector and 5% to the ops wallet below (a skim failure just leaves that slice
# with the creator — nothing is stranded). (Off by default.)
# ESKA_FEE_SPLIT=on
# 5% ops share — defaults to the ESKA ops wallet below; override here.
# ESKA_OPS_WALLET=0x5eBbB80A5E52833dC122d181EBdbD4eBF70Dddb2

# ─── $ESKA buyback & burn (optional, spends real funds — keep OFF until tested) ─
# The other 5% of the ESKA share is sent to a server-controlled collector wallet
# (derived from a fixed id, not the ops wallet). The buyback endpoint swaps that
# collector's WETH for $ESKA and sends it straight to the burn address.
#
# SAFETY: this endpoint spends real money, so it is locked down and OFF by
# default. Before enabling on mainnet, fund the collector with a TINY amount and
# run one buyback to confirm the swap + burn path end to end.
#   • GET  /api/eska/buyback          — safe: shows the collector address, its
#                                        WETH reserve, ETH-for-gas, and enabled flag.
#   • POST /api/eska/buyback { secret } — runs the buyback; requires the secret.
# The collector needs a little ETH for gas — send some to the address GET reports.
# ESKA_BUYBACK=on
# Shared secret required on POST so nobody else can trigger a buyback.
# ESKA_ADMIN_SECRET=change-me-to-a-long-random-string
# Don't spend gas on a negligible reserve (WETH). Default 0.0005.
# ESKA_BUYBACK_MIN_WETH=0.0005

# ─── Live burn tracker (optional) ───────────────────────────────────────────
# /api/eska/burned reports the on-chain $ESKA held at the burn addresses (which
# can only ever climb). If any $ESKA was burned before this tracker existed, add
# that amount here so the counter reflects the true total. Whole tokens.
# ESKA_BURN_BASELINE=0
